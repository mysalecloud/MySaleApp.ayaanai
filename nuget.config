<?xml version="1.0" encoding="utf-8"?>
<!-- This project only needs nuget.org. <clear/> ignores machine-wide feeds (e.g. Telerik) that need a login. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
